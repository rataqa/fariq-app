// Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
}

model Project {
  id          String @id @db.Uuid
  name        String @unique
  description String

  // relationships
  teams       Team[]
  repos       Repo[]
}

model Team {
  id          String @id @db.Uuid
  name        String @unique
  description String
  projectId   String @db.Uuid

  // relationships
  project     Project @relation(fields: [projectId], references: [id])
  members     Member[]

  // indexes
  @@index([projectId])
}

model Repo {
  id        String @id @db.Uuid
  name      String @unique
  webUrl    String
  projectId String @db.Uuid

  // relationships
  project      Project @relation(fields: [projectId], references: [id])
  pullRequests PullRequest[]

  // indexes
  @@index([projectId])
}

model Member {
  id          String @id @db.Uuid
  descriptor  String @unique
  uniqueName  String @unique
  displayName String
  teamId      String @db.Uuid

  // relationships
  team         Team @relation(fields: [teamId], references: [id])
  pullRequests PullRequest[]

  // indexes
  @@index([teamId])
}

model PullRequest {
  id                  Int @id
  title               String
  description         String
  status              String
  mergeStatus         String
  isDraft             Boolean
  creationDate        String
  closedDate          String?

  // artificial fields
  creationDay         Int
  createdById         String @db.Uuid
  createdByUniqueName String
  repoId              String @db.Uuid

  // relationships
  repo                Repo @relation(fields: [repoId], references: [id])
  createdBy           Member @relation(fields: [createdById], references: [id])

  // indexes
  @@index([creationDay])
  @@index([createdById])
  @@index([createdByUniqueName])
  @@index([repoId])
}

